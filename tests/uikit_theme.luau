-- ui-kit: UITheme pure logic (formatting, colours, metrics tables) headless in Lune.
-- .bin/lune run tests/uikit_theme.luau
require("./prelude")
local T = require("../src/client/UI/UITheme")

local function eq(a, b, what)
	assert(a == b, string.format("%s: expected %q, got %q", what, tostring(b), tostring(a)))
end

-- formatting (ui_theme.gd)
eq(T.fmt_cost(50000), "50K", "fmt_cost 50K")
eq(T.fmt_cost(125000), "125K", "fmt_cost 125K")
eq(T.fmt_cost(1000000), "1M", "fmt_cost 1M")
eq(T.fmt_cost(1500000), "1.5M", "fmt_cost 1.5M")
eq(T.fmt_cost(25000000), "25M", "fmt_cost 25M")
eq(T.fmt_cost(2500), "2.5K", "fmt_cost 2.5K")
eq(T.fmt_cost(999), "999", "fmt_cost 999")
eq(T.fmt_pct(0.099), "9.9%", "fmt_pct 9.9")
eq(T.fmt_pct(0.0028), "0.28%", "fmt_pct 0.28")
eq(T.fmt_pct(0.123), "12.3%", "fmt_pct 12.3")
eq(T.fmt_pct(0), "0.0%", "fmt_pct 0")
eq(T.fmt_time(422), "7:02", "fmt_time 7:02")
eq(T.fmt_time(3725), "1:02:05", "fmt_time h")
eq(T.fmt_time(-3), "0:00", "fmt_time negative")
eq(T.fmt_rate(0.2), "±0/s", "fmt_rate zero")
eq(T.fmt_rate(7000), "+7.0K/s", "fmt_rate +")
eq(T.fmt_rate(-3400), "−3.4K/s", "fmt_rate −")
eq(T.fmt_num(186900), "186K", "fmt_num 186K")
eq(T.fmt_num(1431000), "1.43M", "fmt_num 1.43M")
eq(T.fmt_num(98400), "98.4K", "fmt_num 98.4K")

-- colours
local c = T.c(T.RED, 0.14)
assert(T.is_rgba(c) and math.abs(c.alpha - 0.14) < 1e-9 and c.color == T.RED, "T.c")
local l = T.lerp(T.AMBER, T.WHITE, 0.25)
assert(typeof(l) == "Color3", "lerp of Color3s is a Color3")
local la = T.lerp(T.c(T.RED, 0.2), T.RED, 0.5)
assert(T.is_rgba(la) and math.abs(la.alpha - 0.6) < 1e-9, "lerp alpha")
eq(T.alpha(0x5C9EFF80), 128 / 255, "alpha of RGBA8 int")
local c3 = T.color3(0xFF800000)
assert(math.abs(c3.R - 1) < 1e-6 and math.abs(c3.G - 128 / 255) < 1e-6 and c3.B == 0, "color3 of RGBA8 int")
local dark = T.owner_ui_color(Color3.new(0.1, 0.1, 0.2))
assert(T.luminance(dark) > T.luminance(Color3.new(0.1, 0.1, 0.2)), "owner_ui_color lifts dark colours")
eq(T.msg_color(3), T.RED, "msg_color alert")
eq(T.msg_icon(4), "alliance", "msg_icon alliance")

-- metrics: Godot tnum template widths (verified against the font with fontTools)
eq(T.text_width("888.8M", 20, 700), 76, "text_width 888.8M")
eq(T.text_width("8888.8M", 20, 700), 89, "text_width 8888.8M")
eq(T.text_width("/ 888.8M", 13, 500), 57, "text_width cap")
eq(T.text_width("+888.8K/s", 11, 700), 59, "text_width rate")
eq(T.text_width("888.8M at war", 11, 700), 79, "text_width at war")
eq(T.text_width("8:88:88", 20, 700), 78, "text_width clock")
eq(T.text_width("TROOPS", 11, 700), 45, "text_width TROOPS")
-- line heights (FreeType-rounded ascent + descent, as the original's layout)
eq(T.line_height(10), 13, "line_height 10")
eq(T.line_height(11), 14, "line_height 11")
eq(T.line_height(12), 15, "line_height 12")
eq(T.line_height(20), 24, "line_height 20")
-- UI scale
eq(T.ui_scale(Vector2.new(1920, 1080), false), 1.2, "ui_scale 1080p")
eq(T.ui_scale(Vector2.new(1600, 900), false), 1.0, "ui_scale 900p")
assert(math.abs(T.ui_scale(Vector2.new(1366, 768), false) - 0.85333) < 1e-3, "ui_scale 768p")
eq(T.ui_scale(Vector2.new(844, 390), true), 1.0, "ui_scale phone")

-- styles
local st = T.flat(T.GLASS, T.R_LG, T.LINE, 1, 16, 12)
local l1, t1, r1, b1 = T.margins(st)
assert(l1 == 16 and t1 == 12 and r1 == 16 and b1 == 12, "margins")
local th = T.theme()
assert(th.PrimaryButton.styles.normal.bw_bottom == 3, "primary lip")
assert(th.ChipButton.font_size == 13, "chip font size")

print("uikit_theme ok")
